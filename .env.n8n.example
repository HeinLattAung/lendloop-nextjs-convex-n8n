# Copy to .env.n8n (git-ignored). Same value as N8N_SHARED_SECRET in Convex.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LENDLOOP_SHARED_SECRET=

# Convex HTTP actions URL as seen from inside the n8n container.
# Local Convex deployment:  http://host.docker.internal:3211
# Cloud deployment:         https://<your-deployment>.convex.site
CONVEX_SITE_URL=http://host.docker.internal:3211
