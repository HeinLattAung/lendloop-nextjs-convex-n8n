# ---- Next.js (.env.local) ----
# Written automatically by `npx convex dev`:
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# From the Clerk dashboard -> API keys:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Convex deployment env (set with `npx convex env set NAME value`, NOT in this file) ----
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, e.g. https://xxx.clerk.accounts.dev
# ADMIN_EMAILS              comma-separated emails that get the admin role
# N8N_SHARED_SECRET         32+ random bytes (hex); must equal LENDLOOP_SHARED_SECRET in .env.n8n
# N8N_LOAN_WEBHOOK_URL      e.g. http://localhost:5678/webhook/lendloop-loan-event
